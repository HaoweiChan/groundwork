#!/bin/sh
# Eval gate: no commit may regress the fast suite below the recorded baseline.
cd "$(git rev-parse --show-toplevel)" || exit 1
[ -f evals/run.py ] || exit 0
python3 -m evals.run --suite fast --baseline .eval-baseline.json
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "COMMIT BLOCKED by the eval gate."
  echo "Fix the regression, or record a deliberate baseline move in an ADR."
  exit 1
fi
exit 0
