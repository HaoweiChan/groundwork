#!/bin/sh
# Groundwork source gate. Descendant projects receive their eval gate from the
# bundled scaffold; this repository keeps plugin self-tests out of root evals/.
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 -m unittest discover -s plugin/tests -p 'test_*.py'
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "COMMIT BLOCKED by the Groundwork plugin test gate."
  exit 1
fi
exit 0
